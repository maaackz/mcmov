{
	"schemaVersion": 1,
	"id": "mcmov",
	"version": "${version}",
	"name": "minecraft movie mod",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/mcmov/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.maaackz.mcmov.MinecraftMovieMod"
		],
		"client": [
			"com.maaackz.mcmov.MinecraftMovieModClient"
		]
	},
	"mixins": [
		"mcmov.mixins.json",
		{
			"config": "mcmov.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.13",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}